{
  "name": "@drophawk/mcp",
  "version": "0.1.1",
  "description": "MCP server for DropHawk: Australian PC component prices with buy links, for AI assistants.",
  "keywords": ["drophawk", "mcp", "model-context-protocol", "prices", "price-tracking", "pc-components"],
  "homepage": "https://developers.drophawk.net",
  "bugs": { "url": "https://github.com/drophawk-net/drophawk-js/issues" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drophawk-net/drophawk-js.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": { "drophawk-mcp": "./dist/bin.js" },
  "files": ["dist", "README.md"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun run build && vitest run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@drophawk/sdk": "workspace:^",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
